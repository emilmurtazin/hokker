# Скопируйте этот файл в .env и при необходимости отредактируйте

# PostgreSQL (имена сервисов из docker-compose.yml)
# ВАЖНО: на реальном сервере замените hokker_local_password на длинный
# случайный пароль — сгенерировать можно командой: openssl rand -hex 24
POSTGRES_PASSWORD=hokker_local_password
DATABASE_URL=postgresql://hokker:hokker_local_password@db:5432/hokker

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
# ВАЖНО: на реальном сервере сгенерировать: openssl rand -hex 32
JWT_SECRET_KEY=change-me-to-a-random-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# SMS (по умолчанию console — код печатается в лог, не отправляется)
# Для продакшена: SMS_PROVIDER=smsc + ключ с https://smsc.ru/passwords/
SMS_PROVIDER=console
SMSC_API_KEY=
# Альтернатива apikey — пара логин+пароль (используется, только если apikey пуст)
SMSC_LOGIN=
SMSC_PASSWORD=

# Дежурный код для входа на ЛЮБОЙ номер телефона (App Store/Google Play
# ревью, тестирование). ВАЖНО: пока не пусто — это мастер-ключ от любого
# аккаунта, зная только номер телефона. Оставьте пустым, чтобы отключить.
MASTER_OTP_CODE=2808

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# api.telegram.org заблокирован в РФ — если бэкенд на российском сервере,
# укажите прокси через зарубежный сервер, например:
# TELEGRAM_PROXY_URL=http://user:pass@1.2.3.4:3128
TELEGRAM_PROXY_URL=

# Публичный HTTPS-адрес ФРОНТЕНДА. Обязательно для кнопок бота: они открывают
# приложение внутри Telegram, а Telegram принимает только https://.
APP_PUBLIC_URL=https://24hokker.ru

# Кнопка «Меню» слева от поля ввода в боте:
#   commands — список команд (по умолчанию), webapp — сразу открывает приложение
TELEGRAM_MENU_BUTTON=commands

# Часовой пояс для времени в уведомлениях (в БД всё хранится в UTC)
APP_TIMEZONE=Europe/Moscow

# Фоновые задачи: напоминания о тренировках и истечение приглашений из листа ожидания
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60
# За сколько часов до тренировки напоминать родителю (0 — не напоминать)
REMINDER_HOURS_BEFORE=3
# «Тихие часы» по APP_TIMEZONE: в это время напоминания не отправляются
QUIET_HOURS_START=22
QUIET_HOURS_END=8

# Домены фронтенда, которым разрешено обращаться к API (через запятую)
CORS_ORIGINS=http://localhost:5173

# Окружение
ENVIRONMENT=local
